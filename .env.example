# MEETME Production Environment Configuration
# Supabase PostgreSQL Database (Transaction Pooler or Direct Connection)
# Format 1 (Supabase Transaction Pooler, Recommended for Serverless/Render):
# postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Format 2 (Supabase Direct Connection):
# postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Providers (Groq Speed + Gemini Deep Synthesis)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Native Gmail SMTP Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=yourmail@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_NAME=MEETME Intelligence
SMTP_TIMEOUT=10
APP_FRONTEND_URL=http://localhost:3000

# Production Server Config
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
PYTHONPATH=.
